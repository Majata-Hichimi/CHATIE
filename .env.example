# Server settings
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Session secret (generate a long random string, e.g. 64 hex chars)
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters_long

# MySQL connection for the running application (MUST be least-privilege chat_app)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatroom_db
DB_USER=chat_app
DB_PASSWORD=CHANGE_ME_app

# MySQL credentials used ONLY by setup-db, seed.js, and demo scripts (never by src/app.js)
DB_ADMIN_USER=chat_admin
DB_ADMIN_PASSWORD=CHANGE_ME_admin
DB_READONLY_USER=chat_readonly
DB_READONLY_PASSWORD=CHANGE_ME_readonly

# Optional MySQL TLS/SSL connection
DB_SSL=false
# DB_SSL_CA=./certs/mysql-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Optional HTTPS/TLS for the Express API
TLS_ENABLED=false
# TLS_KEY_PATH=./certs/server.key
# TLS_CERT_PATH=./certs/server.crt

# Demonstration mode (MUST be false in production; enables /api/demo/login-unsafe on localhost only)
DEMO_MODE=false
